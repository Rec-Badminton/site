  "pages": {
    "registrationNotice": {
      "enabled": true,
      "text": {
        "fr": "<0>Les inscriptions adultes sont closes.</0> Inscris-toi sur la <1>liste d'attente</1> pour être contacté si des places se libèrent. Des inscriptions jeunes sont encore possibles !",
        "en": "<0>Adult registrations are closed.</0> Join the <1>waiting list</1> to be contacted when spots open up. Youth registrations are still open!"
      }
    },
    "trialRules": [
      {
        "text": {
          "fr": "<0>Préviens-nous par mail</0> plusieurs jours avant ta venue : les places sont limitées, même pour les essais. Nous pourrons aussi te guider vers le créneau le plus adapté à tes envies.",
          "en": "<0>Email us</0> a few days before you come: spots are limited, even for trials. We can also point you to the session that suits you best."
        }
      },
      {
        "text": {
          "fr": "<0>Présente-toi au début du créneau</0> à un membre du bureau.",
          "en": "<0>Introduce yourself at the start</0> to a board member."
        }
      },
      {
        "text": {
          "fr": "<0>Remplis le formulaire le jour même</0> de ta séance, en flashant ou cliquant sur le QR code : il t'assure pendant 24h pour la pratique du badminton.",
          "en": "<0>Fill in the form on the day</0> of your session by scanning or clicking the QR code: it insures you for 24 hours of badminton."
        }
      }
    ],
    "included": [
      {
        "text": {
          "fr": "L'adhésion au club et une licence fédérale (FFBaD) incluant une assurance",
          "en": "Club membership and an FFBaD licence including insurance"
        }
      },
      {
        "text": {
          "fr": "<0>L'accès à 2 créneaux par semaine</0> (entraînements ou jeu libre) parmi les créneaux à places limitées",
          "en": "<0>Access to 2 sessions a week</0> (coaching or open play) among the sessions with limited spots"
        }
      },
      {
        "text": {
          "fr": "<0>L'accès libre aux créneaux supplémentaires</0> dont les places ne sont pas limitées",
          "en": "<0>Free access to extra sessions</0> without limited spots"
        }
      },
      {
        "text": {
          "fr": "L'accès aux événements organisés par le club",
          "en": "Access to the events organised by the club"
        }
      },
      {
        "text": {
          "fr": "L'accès à la boutique et aux tarifs avantageux chez nos partenaires",
          "en": "Access to the shop and to discounts from our partners"
        }
      }
    ],
    "discounts": [
      {
        "text": {
          "fr": "<0>−15 € pour les étudiants</0>, justificatif à joindre lors de l'inscription en ligne",
          "en": "<0>€15 off for students</0>, with proof attached when signing up online"
        }
      },
      {
        "text": {
          "fr": "<0>Réduction Pass'Sport</0> sur présentation d'un justificatif lors de l'inscription en ligne",
          "en": "<0>Pass'Sport discount</0> with proof when signing up online"
