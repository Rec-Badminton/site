{
  "hosting": {
    "public": "dist",
    "redirects": [{ "source": "/logo/:file*", "destination": "/assets/logo/:file", "type": 301 }],
    "rewrites": [{ "source": "/admin/**", "destination": "/admin/index.html" }],
    "headers": [
      {
        "regex": "^/assets/(js|css|fonts|images|misc)/.+-[A-Za-z0-9_-]{8}\\.[a-z0-9]+$",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "regex": "^([^.]*|.*\\.html)$",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", "src/**/*.test.ts"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ]
}
