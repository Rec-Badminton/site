{
  "name": "rec-bad",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"functions/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"functions/src/**/*.ts\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"functions/src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"functions/src/**/*.ts\" --fix",
    "format-lint": "npm run format && npm run lint:fix",
    "build": "vite build",
    "preview": "vite preview",
    "pdf:booklet": "node scripts/render-booklet.mjs"
  },
  "dependencies": {
    "@mxreakit/i18n": "^0.1.10",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.105.2",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "firebase": "^13.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@mxreakit/configs": "^0.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
